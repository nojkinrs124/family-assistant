# Получить у @BotFather
TELEGRAM_BOT_TOKEN=

# openrouter.ai -> Keys. LLM-провайдер агента (OpenAI-совместимый API).
OPENROUTER_API_KEY=sk-or-v1-...
# Необязательно — модель по умолчанию openai/gpt-4o-mini (дёшево,
# надёжно по вызову тулов). Можно переопределить на любую с OpenRouter,
# например google/gemini-2.0-flash-001 или deepseek/deepseek-chat.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Supabase -> Project Settings -> API
SUPABASE_URL=https://ofoxcgswiucxatmtjgsz.supabase.co
# ВНИМАНИЕ: service_role key обходит RLS. Только на сервере бота,
# никогда не в клиентском коде, никогда не коммитить.
SUPABASE_SERVICE_ROLE_KEY=
